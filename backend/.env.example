# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRE=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
MAX_FILE_SIZE=10485760

# ── Frontend URL (used in verification email link) ────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your account password
# Create one at: Google Account > Security > 2-Step Verification > App passwords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# ── Google OAuth ──────────────────────────────────────────────────────────────
CLIENT_ID_OAUTH=your_google_client_id.apps.googleusercontent.com
CLIENT_SECRET_OAUTH=your_google_client_secret

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
